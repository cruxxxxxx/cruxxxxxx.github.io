---
import BlogLayout from '../../blog/BlogLayout.astro';
import PostList from '../../blog/components/PostList.astro';
import { getPublishedPosts } from '../../blog/lib/posts';

const posts = await getPublishedPosts();
---

<BlogLayout>
  {posts.length === 0
    ? <p class="note">nothing yet.</p>
    : <PostList posts={posts} />}
</BlogLayout>
